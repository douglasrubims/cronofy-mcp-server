# Cronofy MCP — production env.
# Copy to .env.production and fill in.
# Cursor: set MCP_ENV=production in mcp.json → cronofy "env".

CRONOFY_CLIENT_ID=
CRONOFY_CLIENT_SECRET=
CRONOFY_REFRESH_TOKEN=
# Optional: comma-separated application_calendar_id values for cronofy_list_application_calendars
# CRONOFY_APPLICATION_CALENDAR_IDS=pompano-beach,other-id
# Optional; default US:
# CRONOFY_API_BASE=https://api.cronofy.com
