{
  "name": "cronofy-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Local stdio MCP server for the Cronofy calendar API (calendars, events, free/busy, availability).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cronofy",
    "calendar",
    "cursor",
    "stdio"
  ],
  "homepage": "https://github.com/douglasrubims/cronofy-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglasrubims/cronofy-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/douglasrubims/cronofy-mcp-server/issues"
  },
  "files": [
    "src",
    "load-package-env.mjs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "bin": {
    "cronofy-mcp": "./src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check": "biome check --write"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cronofy": "^3.8.4",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}